// Postgres (e.g. Neon from the Vercel Marketplace). Tables are created on deploy by `vercel-build`.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Money is stored as integer "millicents": 1 USD = 100,000 mc.
model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  balanceMc    Int             @default(0)
  createdAt    DateTime        @default(now())
  sessions     RenderSession[]
  topUps       TopUp[]
  jobs         Job[]
  chats        DirectorChat[]
}

model RenderSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  resolution    String
  // pending -> active -> ended
  status        String    @default("pending")
  falSessionId  String?   @unique
  startedAt     DateTime?
  lastChargedAt DateTime?
  endedAt       DateTime?
  endReason     String?
  billedSeconds Float     @default(0)
  // What the user paid vs. what fal charged you. The difference is your profit.
  chargedMc     Int       @default(0)
  falCostMc     Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([userId, status])
}

model TopUp {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  stripeSessionId String   @unique
  amountMc        Int
  createdAt       DateTime @default(now())
}

// One generation from the Create playground (a clip, image, voice or edit), run on fal's queue.
model Job {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  toolId       String
  endpoint     String
  // queued -> running -> done | failed
  status       String    @default("queued")
  prompt       String?
  input        Json
  outputType   String
  outputUrls   String[]  @default([])
  error        String?
  falRequestId String?
  statusUrl    String?
  responseUrl  String?
  // The price is fixed up front; a failed job is refunded once.
  chargedMc    Int
  falCostMc    Int
  refunded     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  // Set when the AI Director started the job; `notified` once the Director has been told it finished.
  chatId       String?
  notified     Boolean   @default(false)

  @@index([userId, createdAt])
  @@index([chatId])
}

// A conversation with the AI Director agent.
model DirectorChat {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String   @default("New chat")
  // The Claude conversation, append-only (thinking blocks must be replayed unchanged).
  messages    Json     @default("[]")
  // Generations waiting for the user's approval, and the tool results already computed for that turn.
  pending     Json?
  effort      String   @default("medium")
  askApproval Boolean  @default(true)
  // What the assistant itself has cost the user so far (generations are counted on their jobs).
  aiChargedMc Int      @default(0)
  aiCostMc    Int      @default(0)
  // Held while a reply is being generated, so two replies never run on one chat at once.
  lockedUntil DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, updatedAt])
}
