{
  "name": "moviedirector",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && (test -z \"$DATABASE_URL\" || prisma db push --skip-generate) && next build"
  },
  "dependencies": {
    "@fal-ai/client": "1.11.0-alpha.5",
    "@fal-ai/server-proxy": "1.3.0-alpha.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.12",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "stripe": "18.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
