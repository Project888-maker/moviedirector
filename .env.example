# --- fal.ai -----------------------------------------------------------------
# Server-side only. Never expose this to the browser.
FAL_KEY="your-fal-key"

# --- Pricing ----------------------------------------------------------------
# What fal charges you per billable second (see the model page).
FAL_PRICE_PER_SECOND_USD="0.05"
# Your margin on top of fal's cost. 30 means users pay 1.3x what fal charges you.
MARKUP_PERCENT="30"
# Users need at least this many seconds of balance to start a session.
MIN_START_SECONDS="30"
# Optional free credit (USD) for new accounts.
SIGNUP_BONUS_USD="0"

# --- App --------------------------------------------------------------------
APP_URL="http://localhost:3000"
# Long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET="change-me"
# Comma separated emails that can open /admin
ADMIN_EMAILS="you@example.com"
DATABASE_URL="file:./dev.db"

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
